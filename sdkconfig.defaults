# ---- Target / flash ----
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- OTA ----
# A freshly updated image boots in "pending verify".  main.c marks it valid
# once WiFi and the web UI are up; otherwise the bootloader rolls back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"

# ---- FreeRTOS / system ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Brownout detector ----
# TEMPORARY: the FTDI +5V rail dips during WiFi/BT RF calibration and trips
# the detector even with an added capacitor.  Remove this line (re-enable the
# detector) once the board is powered from a stable 5V supply.
# CONFIG_ESP_BROWNOUT_DET is not set

# ---- PSRAM (ESP32-CAM AI-Thinker: 4 MB, CS on GPIO16) ----
# IGNORE_NOTFOUND keeps the board booting on clones without PSRAM so the
# self-test can report the real size instead of rebooting forever.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# ---- Bluetooth: classic only (A2DP needs classic; BLE is not used) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n
CONFIG_BT_BLUEDROID_MEM_DEBUG=n
# The ESP32 controller defaults to BLE-only.  A2DP needs BR/EDR.
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0

# ---- WiFi ----
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n

# ---- Web server ----
# Browsers send ~700 bytes of headers on a form POST; the 512-byte default
# makes /save fail with "Header fields are too long".
CONFIG_HTTPD_MAX_REQ_HDR_LEN=3072
CONFIG_HTTPD_MAX_URI_LEN=1024

# ---- NTP / time ----
CONFIG_LWIP_SNTP_MAX_SERVERS=3
